{
  "cli": {
    "version": ">= 16.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "24.12.0",
      "env": {
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "$EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY",
        "EXPO_PUBLIC_S3_REGION": "$EXPO_PUBLIC_S3_REGION",
        "EXPO_PUBLIC_S3_BUCKET": "$EXPO_PUBLIC_S3_BUCKET",
        "EXPO_PUBLIC_S3_ACCESS_KEY_ID": "$EXPO_PUBLIC_S3_ACCESS_KEY_ID",
        "EXPO_PUBLIC_S3_SECRET_ACCESS_KEY": "$EXPO_PUBLIC_S3_SECRET_ACCESS_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "24.12.0",
      "env": {
        "EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY": "$EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY",
        "EXPO_PUBLIC_S3_REGION": "$EXPO_PUBLIC_S3_REGION",
        "EXPO_PUBLIC_S3_BUCKET": "$EXPO_PUBLIC_S3_BUCKET",
        "EXPO_PUBLIC_S3_ACCESS_KEY_ID": "$EXPO_PUBLIC_S3_ACCESS_KEY_ID",
        "EXPO_PUBLIC_S3_SECRET_ACCESS_KEY": "$EXPO_PUBLIC_S3_SECRET_ACCESS_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
